# TokenPak — Environment Variables Example
# Copy to .env and fill in your values.
# Full reference: docs/env-vars.md

# ─── Required: API Keys ───────────────────────────────────────────────────────
# At least one provider key is required. TokenPak routes to whichever are set.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# ─── Optional: Multiple Anthropic Keys (key rotation / failover) ──────────────
# Add up to 5 keys — TokenPak rotates automatically on 429/503
# ANTHROPIC_API_KEY_2=sk-ant-...
# ANTHROPIC_API_KEY_3=sk-ant-...

# ─── Server ──────────────────────────────────────────────────────────────────
TOKENPAK_PORT=8766
# TOKENPAK_BIND_ADDRESS=127.0.0.1     # Use 0.0.0.0 for LAN/Docker access
# TOKENPAK_PROXY_KEY=                  # Optional pre-shared key for auth (empty = disabled)
# TOKENPAK_DASHBOARD_AUTH=true         # Require auth to access /stats, /health, /vault

# ─── Profile & Compression ────────────────────────────────────────────────────
# TOKENPAK_PROFILE=balanced            # balanced | economy | quality
# TOKENPAK_COMPACT=true               # Master switch for context compaction
# TOKENPAK_MODE=hybrid                 # strict | hybrid | aggressive

# ─── Vault / Retrieval ────────────────────────────────────────────────────────
# TOKENPAK_VAULT_INDEX=~/vault/.tokenpak
# TOKENPAK_VAULT_INDEX_RELOAD_INTERVAL=300

# ─── Logging ─────────────────────────────────────────────────────────────────
# TOKENPAK_LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
# TOKENPAK_DB=./monitor.db             # Path to SQLite monitor database
